# TorBox Telegram Bot — Environment Variables
# Copy this to .env and fill in your values

# ============================================================
# REQUIRED
# ============================================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your TorBox API Key (from https://torbox.app/settings)
# This is the DEFAULT key — used if a user hasn't set their own via /setkey
TORBOX_API_KEY=your_torbox_api_key_here

# ============================================================
# ACCESS CONTROL
# ============================================================

# Your Telegram user ID — grants you admin commands:
#   /adduser, /removeuser, /listusers, /broadcast
# Find your ID: message @userinfobot on Telegram
BOT_ADMIN_ID=your_telegram_user_id_here

# Web Admin Panel Credentials (http://localhost:3001/admin)
ADMIN_WEB_USERNAME=admin
ADMIN_WEB_PASSWORD=your_secure_admin_password_here

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave EMPTY to allow ALL users (open access).
# If set, ONLY these users can use the bot.
# Admin can also add/remove at runtime via /adduser and /removeuser.
ALLOWED_USERS=123456789,987654321

# ============================================================
# TORBOX API (optional overrides)
# ============================================================

# TorBox API base URL (default: https://api.torbox.app)
# TORBOX_API_BASE=https://api.torbox.app

# TorBox API version (default: v1)
# TORBOX_API_VERSION=v1

# ============================================================
# BOT SETTINGS (optional)
# ============================================================

# Items per page in lists (default: 5)
# PAGE_SIZE=5

# Session timeout in ms (default: 300000 = 5 min)
# SESSION_TIMEOUT_MS=300000

# ============================================================
# PLAN FEATURE MATRIX (for reference — enforced automatically)
# ============================================================
# Free    (plan 0): Torrents (CACHED ONLY), no usenet, no webdl, no RSS
# Essential (plan 1): Torrents + Usenet + WebDL + RSS + Notifications
# Pro     (plan 2): Everything + higher limits
# Ultimate (plan 3): Everything + unlimited slots
#
# Plan is auto-detected when the user sets their API key via /setkey
# or runs /me. No manual configuration needed.
